# Required
DATABASE_URL=postgresql://hometower:secret@db:5432/hometower
# SECRET_KEY: generate a strong random key (32 bytes hex) before production
# Example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_32_random_bytes_minimum
ADMIN_EMAIL=admin@hometower.local
ADMIN_PASSWORD=changeme_on_first_boot
# Used ONLY on first boot to seed the initial admin. After first boot, change your
# password in Settings → Profile and remove this line. DO NOT keep the placeholder.

# Development mode: set to true to allow placeholder secrets (fatal in production)
DEV_MODE=true

# Optional (defaults shown)
JWT_EXPIRE_HOURS=24
LOG_LEVEL=INFO
# COOKIE_SECURE defaults to true (HTTPS). Set false for local dev over HTTP.
COOKIE_SECURE=false
# DB_PASSWORD: do NOT leave blank in production. Generate a strong random password.
# Example: python -c "import secrets; print(secrets.token_urlsafe(24))"
DB_PASSWORD=
# Optional: separate secret for NiceGUI storage to avoid JWT/session key reuse.
# If left empty, a distinct value will be derived from SECRET_KEY at runtime.
# STORAGE_SECRET=
